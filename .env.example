# =============================================================================
# ComplianceIQ (AWS External Edition) — environment template
# Copy to .env for LOCAL development only. In the deployed AWS container these
# values come from the task definition + Secrets Manager + the IAM task role
# (NOT from a .env file). NEVER commit a real .env.
# =============================================================================

PORT=3000

# --- AWS / Bedrock (AI engine) ---------------------------------------------
# Region where you have Amazon Bedrock model access.
AWS_REGION=us-east-1
# Bedrock model id. The server auto-detects Nova vs Claude payload shape.
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0
# For LOCAL dev only: provide credentials for an AWS account that has Bedrock
# access. In AWS (ECS), OMIT these — the IAM task role is used automatically.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- Tavily (web search for live regulatory news/search) --------------------
# Your own Tavily API key (https://tavily.com). In AWS this is injected from
# Secrets Manager (complianceiq/<env>/tavily-api-key), not from here.
TAVILY_API_KEY=tvly-YOUR-KEY

# --- App ---------------------------------------------------------------------
APP_URL=http://localhost:3000
DATA_DIR=./data/regions   # in AWS this is /app/data (EFS mount)
